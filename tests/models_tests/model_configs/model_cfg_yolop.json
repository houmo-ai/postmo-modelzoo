{
    "obsolete": false,
    "model_dir": "models/autodrive/yolop",
    "support_platform": ["x86_64"],
    "support_backend": ["xh1", "xh2"],
    "support_core_num": {
        "xh1": [1],
        "xh2": null
    },
    "support_flow": {
        "xh1": ["get_model", "quant", "compile", "demo", "perf", "compare"],
        "xh2": ["get_model", "quant", "compile", "demo", "perf", "compare"]
    },
    "support_hmassist": {
        "xh1": ["hmquant", "hmbuild", "hmdemo", "hmcompare", "hmperf"],
        "xh2": ["hmquant", "hmbuild", "hmdemo", "hmcompare", "hmperf"]
    },
    "perf_metrics": {
        "xh1":{
            "x86_64": 129.104
        },
        "xh2":{
            "x86_64": 21.643
        }
    },
    "eval_threshold": {
        "map50": 0.95,
        "map50_95": 0.90
    },
    "get_model_params": {
        "xh1": {
            "type": ["default", "raw", "quant", "all"],
            "quant_model_dir": ["default", "", "./"],
            "model_dir": ["default", "", "./"]
        },
        "xh2": {
            "type": ["default", "raw", "all"],
            "quant_model_dir": ["default", "", "./"],
            "model_dir": ["default", "", "./"]
        }
    },
    "hmquant_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1"]
            },
            "optional": {
                "result_path": ["default"]
            }
        }
    },
    "hmbuild_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1", "xh2"]
            },
            "optional": {
                "result_path": ["default"],
                "ncore": ["default", "1", "2", "4"],
                "opt_level": ["default", "0", "1", "2"]
            }
        }
    },
    "hmdemo_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1"]
            },
            "optional": {
                "result_path": ["default"],
                "onnx": ["default"]
            }
        }
    },
    "hmperf_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1"],
                "warmup": ["1", "10", "10"],
                "sample": ["1", "1000", "1000"]
            },
            "optional": {
                "result_path": ["default"],
                "loop_num": ["default"],
                "thread": ["default", "4", "8"],
                "device": ["default"]
            }
        }
    },
    "hmcompare_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1"],
                "data_path": ["./bdd100k/images/100k/val/b1c9c847-3bda4659.jpg"]
            },
            "optional": {
                "result_path": ["default"]
            }
        }
    }
}