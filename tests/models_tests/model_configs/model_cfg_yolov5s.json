{
    "obsolete": false,
    "model_dir": "models/detection/yolov5s",
    "support_platform": ["x86_64"],
    "support_backend": ["xh1", "xh2"],
    "support_core_num": {
        "xh1": [1],
        "xh2": null
    },
    "support_flow": {
        "xh1": ["get_model", "quant", "compile", "demo", "compare", "perf", "eval"],
        "xh2": ["get_model", "quant", "compile", "demo", "compare", "perf", "eval"]
    },
    "support_hmassist": {
        "xh1": ["hmquant", "hmbuild", "hmdemo", "hmeval", "hmperf", "hmcompare"],
        "xh2": ["hmquant", "hmbuild", "hmdemo", "hmeval", "hmperf", "hmcompare"]
    },
    "perf_metrics": {
        "xh1":{
            "x86_64": 1215.371
        }
    },
    "eval_threshold": {
        "map50": 0.95,
        "map50_95": 0.90
    },
    "get_model_params": {
        "xh1": {
            "type": ["default", "raw", "quant", "all"],
            "quant_model_dir": ["default", "", "./"],
            "model_dir": ["default", "", "./"]
        },
        "xh2": {
            "type": ["default", "raw", "all"],
            "quant_model_dir": ["default", "", "./"],
            "model_dir": ["default", "", "./"]
        }
    },
    "quant_params": {
        "model_path": ["default", ""],
        "model_name": ["default", ""],
        "input_shape": ["default"],
        "dynamic_resize": ["default"],
        "model_dir": ["default"]
    },
    "compile_params": {
        "model_dir": ["default"],
        "model_name": ["default"],
        "batch": ["default"],
        "ncore": ["default"],
        "input_shape": ["default"],
        "dynamic_resize": ["default"],
        "stage": ["default"],
        "output_dir": ["default"],
        "verbose": ["default"]
    },
    "hmquant_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1"]
            },
            "optional": {
                "result_path": ["default"]
            }
        }
    },
    "hmbuild_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1", "xh2"]
            },
            "optional": {
                "result_path": ["default"],
                "ncore": ["default", "1", "2", "4"],
                "opt_level": ["default", "0", "1", "2"]
            }
        }
    },
    "hmdemo_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1"]
            },
            "optional": {
                "result_path": ["default"],
                "onnx": ["default"]
            }
        }
    },
    "hmperf_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1"],
                "warmup": ["1", "10"],
                "sample": ["1", "1000"]
            },
            "optional": {
                "result_path": ["default"],
                "loop_num": ["default"],
                "thread": ["default", "4"],
                "device": ["default"]
            }
        }
    },
    "hmeval_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1"]
            },
            "optional": {
                "result_path": ["default"],
                "onnx": ["default"]
            }
        }
    },
    "hmcompare_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1"],
                "data_path": ["./coco2017/val2017/000000000139.jpg"]
            },
            "optional": {
                "result_path": ["default"]
            }
        }
    }
}