            }
        }
    },
    "hmbuild_params": {
        "xh2": {
            "required": {
                "config": ["./det.yml", "./rec.yml"]
            },
            "optional": {
                "result_path": [null, null],
                "batch": [null, null],
                "ncore": [null, null],
                "opt_level": [null, null],
                "roi_num": [null, null]
            }
        }
    },
    "demo_params": {
        "xh2": {
            "image": ["./ocr.jpeg"],
            "det-path": ["cached_results/output/xh2/paddleocr_v5_det_xh2_b1_1core_O2.hmm"],
            "rec-path": ["cached_results/output/xh2/paddleocr_v5_rec_xh2_b6_1core_O2.hmm"],
            "output": ["ocr_result.jpg"]
        }
    },
    "test_sh_params": {
