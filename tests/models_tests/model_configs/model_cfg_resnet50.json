{
    "obsolete": false,
    "model_dir": "models/backbone/resnet50",
    "support_platform": ["x86_64"],
    "support_backend": ["xh1", "xh2"],
    "support_core_num": {
        "xh1": [1],
        "xh2": null
    },
    "support_flow": {
        "xh1": ["get_model", "quant", "compile", "demo", "compare", "perf", "eval"],
        "xh2": ["get_model", "quant", "compile", "demo", "compare", "perf", "eval"]
    },
    "support_hmassist": {
        "xh1": ["hmquant", "hmbuild", "hmdemo", "hmeval", "hmperf", "hmcompare"],
        "xh2": ["hmquant", "hmbuild", "hmdemo", "hmeval", "hmperf", "hmcompare"]
    },
    "perf_metrics": {
        "xh1":{
            "x86_64": 1733.207
        },
        "xh2":{
            "x86_64": 484.411
        }
    },
    "eval_threshold": {
        "top1_acc": 0.95
    },
    "get_model_params": {
        "xh1": {
            "type": ["default", "raw", "quant", "all"],
            "quant_model_dir": ["default", "", "./"],
            "model_dir": ["default", "", "./"]
        },
        "xh2": {
            "type": ["default", "raw", "all"],
            "quant_model_dir": ["default", "", "./"],
            "model_dir": ["default", "", "./"]
        }
    },
    "hmquant_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1"]
            },
            "optional": {
                "result_path": ["default"]
            }
        }
    },
    "hmbuild_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1", "xh2"]
            },
            "optional": {
                "result_path": ["default"],
                "ncore": ["default", "1", "2", "4"],
                "opt_level": ["default", "0", "1", "2"]
            }
        }
    },
    "hmdemo_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1"]
            },
            "optional": {
                "result_path": ["default"],
                "onnx": ["default"]
            }
        }
    },
    "hmperf_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1"],
                "warmup": ["1", "10", "10"],
                "sample": ["1", "1000", "1000"]
            },
            "optional": {
                "result_path": ["default"],
                "loop_num": ["default"],
                "thread": ["default", "4", "8"],
                "device": ["default"]
            }
        }
    },
    "hmeval_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1"]
            },
            "optional": {
                "result_path": ["default"],
                "onnx": ["default"]
            }
        }
    },
    "hmcompare_params": {
        "params": {
            "required": {
                "config": ["./config.yml"],
                "target": ["xh1"],
                "data_path": ["./imagenet/ILSVRC2012_img_val/ILSVRC2012_val_00000001.JPEG"]
            },
            "optional": {
                "result_path": ["default"]
            }
        }
    }
}