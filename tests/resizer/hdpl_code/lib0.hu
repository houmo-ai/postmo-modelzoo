#endif
TVM_DLL int32_t GetWorkspaceSize(TVMValue* arg_values, int* arg_tcodes, int num_args, TVMValue* ret_values, int* ret_tcodes, void* resource_handle) {
  ret_values[0].v_int64 = 0;
  ret_tcodes[0] = kTVMArgInt;
  return 0;
}

#ifdef __cplusplus
extern "C"
#endif
__host__ int32_t tcim_resizer0___tvm_main__(TVMValue* args, int* type_code, int num_args, TVMValue* out_value, int* out_type_code, void* resource_handle) {
  void *tensors[4];
  tensors[0] = ((TVMValue*)args)[0].v_handle;
  void* input_0_buffer_var = (((DLTensor*)tensors[0])->data);
  tensors[1] = ((TVMValue*)args)[1].v_handle;
  void* output_1_buffer_var = (((DLTensor*)tensors[1])->data);
  tensors[2] = ((TVMValue*)args)[2].v_handle;
  void* const_buffer_var = (((DLTensor*)tensors[2])->data);
  tensors[3] = ((TVMValue*)args)[3].v_handle;
  void* workspace_buffer_var = (((DLTensor*)tensors[3])->data);
  hdplStream_t stream = (hdplStream_t)(((TVMValue*)args)[4].v_handle);
  int round_num = ((TVMValue*)args)[5].v_int64;
  int round_outter = ((TVMValue*)args)[6].v_int64;
  round_outter = 0;
  if (!stream) {
    tcim_resizer0_kernel<<<1, 4>>>(input_0_buffer_var, output_1_buffer_var, const_buffer_var, workspace_buffer_var, round_num, round_outter);
  } else {
    tcim_resizer0_kernel<<<1, 4, stream>>>(input_0_buffer_var, output_1_buffer_var, const_buffer_var, workspace_buffer_var, round_num, round_outter);
  }
  return 0;
}

