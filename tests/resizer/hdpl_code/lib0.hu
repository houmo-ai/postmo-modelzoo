__device__ void nn_hm_imageResizer_0(void *sid_0_let, void *input_0_buffer_var, int round_num ) {
void* input_gm_y = (void*)(((uint64_t)input_0_buffer_var + 0) / 64);
void* input_gm_uv = (void*)((uint64_t)((uint8_t*)input_0_buffer_var + HEIGHT * WIDTH + 0) / 64);
int sm_out_offset = 0;
Addr16 output_sm_addr;
output_sm_addr.array[0] = (void*)(uint64_t)(0 + sm_out_offset);
output_sm_addr.array[1] = (void*)(uint64_t)(0 + sm_out_offset);
output_sm_addr.array[2] = (void*)(uint64_t)(0 + sm_out_offset);
output_sm_addr.array[3] = (void*)(uint64_t)(0 + sm_out_offset);
Array4 core_batch;
core_batch.array[0] = 1;
int img_resize = 1;
int img_ch_ext = 1;
int img_crop = 0;
int img_inter_type = 1;
int coor_map_para = 1;
int nearest_half_mode = 0;
int img_mem_type = 3;
int src_d1_m1 = WIDTH - 1;
int src_d2_m1 = HEIGHT - 1;
int src_stride_y = WIDTH;
int src_crop_x_offset =
0;
int dst_d1_m1 = O_WIDTH - 1;
int dst_d2_m1 = O_HEIGHT - 1;
int dst_stride_d1 = 128;
int pad_value = 128;
int pad_size = 0;
int uint_trans = 1;
uint64_t resize_factor_w = (uint64_t)((CROP_WIDTH * 1.0 / (2 * O_WIDTH)) * 65536 + 0.5) * 2;
uint64_t resize_factor_h = (uint64_t)((CROP_HEIGHT * 1.0 / (2 * O_HEIGHT)) * 65536 + 0.5) * 2;
int img_size_align64 = ROUND_UP(ROUND_UP(WIDTH * HEIGHT, 64) + WIDTH * HEIGHT * 2, 64);
int output_sm_offset = ROUND_UP(O_WIDTH / 2, 16) * O_HEIGHT * 8;
base_image_resizer_batch(input_gm_y, input_gm_uv, output_sm_addr, core_batch,
         img_resize, img_ch_ext, img_crop, img_inter_type,
         coor_map_para, nearest_half_mode, img_mem_type, src_d1_m1, src_d2_m1,
         src_stride_y, src_crop_x_offset, dst_d1_m1, dst_d2_m1, dst_stride_d1,
         pad_value, pad_size, uint_trans, resize_factor_w, resize_factor_h, img_size_align64, output_sm_offset);
// fake sync
image_resizer_sync_base(true);

}

__device__ void op_hm_store_1(void *output_1_buffer_var, void *sid_0_let, int round_num ) {
void *dst_addr_gm = output_1_buffer_var;
int fm_h_sm = 288;
void* src_addr_sm[16];
src_addr_sm[0] = (void*)0;
src_addr_sm[1] = (void*)0;
src_addr_sm[2] = (void*)0;
src_addr_sm[3] = (void*)0;
const int fm_w_sm = 512;
const int fm_c_sm = 64;
const int precision = 0;
int n_array[4] = {1,};
BaseStoreToGm(dst_addr_gm, src_addr_sm, n_array, fm_h_sm, fm_w_sm, fm_c_sm, fm_c_sm, fm_c_sm, precision);
// no need sync for store
}

__global__ void tcim_resizer0_kernel(void *input_0_buffer_var, void *output_1_buffer_var, void *global_const_workspace_0_var, void *global_workspace_1_var, int round_num, int round_outter) {
  void* sid_0_let = (&(((uint8_t*)global_workspace_1_var)[0]));
int n = round_outter ? 1 : round_num;
for (int i = 0; i < n; i++) {

  //$sid_0_let  := nn.hm_imageResizer($input_0_buffer_var, );
  nn_hm_imageResizer_0(sid_0_let, input_0_buffer_var, round_num );

  //$output_1_buffer_var  := op.hm_store($sid_0_let, );
  // op_hm_store_1(output_1_buffer_var, sid_0_let, round_num );

}

}



