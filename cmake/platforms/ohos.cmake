# OpenHarmony (OHOS) platform configuration for houmo_infer.

set(POSTMO_PLATFORM_NAME "ohos")
set(POSTMO_NEED_PTHREAD TRUE)
set(POSTMO_CXX17_FLAG "-std=c++17")
set(POSTMO_COMPILE_OPTIONS -Wno-deprecated-declarations)
set(POSTMO_RELEASE_FLAGS "-O3 -DNDEBUG -DEIGEN_MPL2_ONLY")
set(POSTMO_DEBUG_FLAGS "-g -O0 -ggdb")
set(POSTMO_EXPORT_ALL_SYMBOLS FALSE)
set(POSTMO_TARGET_LINK_OPTIONS "")

# Use CMAKE_SYSTEM_PROCESSOR from cross-compile toolchain (aarch64 for OHOS)
if(DEFINED CMAKE_SYSTEM_PROCESSOR AND NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "")
  set(ARCH ${CMAKE_SYSTEM_PROCESSOR})
else()
  execute_process(
    COMMAND uname -m
    OUTPUT_VARIABLE ARCH
    OUTPUT_STRIP_TRAILING_WHITESPACE
  )
endif()
set(POSTMO_TARGET "$ENV{POSTMO_TARGET}")
set(LIB_PATH "OHOS_${ARCH}_${POSTMO_TARGET}")

if(DEFINED ENV{POSTMO_EXAMPLES_PATH})
  file(TO_CMAKE_PATH "$ENV{POSTMO_EXAMPLES_PATH}" POSTMO_EXAMPLES_ROOT)
  set(LIB_INSTALL_PATH "${POSTMO_EXAMPLES_ROOT}/utils/ohos")
endif()

# OHOS/musl libc needs explicit c++ and c++abi linkage
set(POSTMO_EXTRA_LIBS c++ c++abi)