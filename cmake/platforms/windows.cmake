# Windows platform configuration for houmo_infer.

set(POSTMO_PLATFORM_NAME "windows")
set(POSTMO_NEED_PTHREAD FALSE)
set(POSTMO_CXX17_FLAG "/std:c++17")
set(POSTMO_COMPILE_OPTIONS /utf-8 /wd4996)
set(POSTMO_RELEASE_FLAGS "/O2 /DNDEBUG")
set(POSTMO_DEBUG_FLAGS "")
set(POSTMO_EXPORT_ALL_SYMBOLS TRUE)
set(POSTMO_TARGET_LINK_OPTIONS /IGNORE:4197)

if(DEFINED ENV{POSTMO_EXAMPLES_PATH})
  set(LIB_INSTALL_PATH "$ENV{POSTMO_EXAMPLES_PATH}/utils/lib")
endif()
